@model Listener.Data.Recording
@{ ViewData["Title"] = "Chi tiết"; }
<section class="hero"><p class="eyebrow">@Model.StartedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</p><h1>@(Model.Title ?? "Bản ghi chưa đặt tên")</h1></section>
<div class="grid two"><section class="card"><audio controls preload="metadata" src="/recordings/@Model.Id/audio"></audio><dl><dt>Thời lượng</dt><dd>@Model.Duration</dd><dt>Kích thước</dt><dd>@Format.Bytes(Model.ByteCount)</dd><dt>Âm lượng TB</dt><dd>@Model.AverageRms.ToString("P1")</dd><dt>Mức đỉnh</dt><dd>@Model.PeakLevel.ToString("P1")</dd><dt>Có tiếng nói</dt><dd>@Model.SpeechRatio.ToString("P1")</dd></dl><p class="muted">Các số đo mô tả tín hiệu âm thanh, không đánh giá tầm quan trọng.</p></section>
<section class="card"><h2>@(Model.IsProtected ? "Đang được bảo vệ" : "Chưa được bảo vệ")</h2><p>Bản ghi được bảo vệ không bị tự động hoặc thủ công xóa cho đến khi bạn bỏ bảo vệ.</p><form asp-action="Protect" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="value" value="@(!Model.IsProtected)"/><button class="primary">@(Model.IsProtected ? "Bỏ bảo vệ" : "Bảo vệ")</button></form></section></div>
