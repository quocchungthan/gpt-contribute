{
  "SupportedLocales": [
    { "CountryCode": "VN", "LanguageCode": "vi", "DisplayName": "Vietnam", "LanguageDisplayName": "Tiếng Việt" }
  ],
  "Retention": { "MaximumAgeDays": 7 },
  "Storage": { "MaximumBytes": 5368709120, "WarningThresholdPercent": 80 },
  "Capture": {
    "FrameMilliseconds": 100,
    "VoiceThresholdRms": 0.012,
    "PreRollSeconds": 3,
    "PostRollSeconds": 5,
    "SilenceGapSeconds": 2,
    "MaximumChunkMinutes": 15
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "localhost;127.0.0.1;[::1]"
}
